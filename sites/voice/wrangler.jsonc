{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "voice",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "voice.apps.mauriciopoppe.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
